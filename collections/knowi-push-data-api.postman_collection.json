      "item": [
        {
          "id": "320aa0bd-f9ad-43f9-8c35-b81e1ddf54cf",
          "name": "Push data to dataset",
          "request": {
            "name": "Push data to dataset",
            "description": {
              "content": "Send real-time data to a Knowi dataset. If the named entity does not exist, a new dataset is created. Optional override strategies allow replacing the entire dataset or replacing values keyed by specific fields.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "live",
                ":identifier"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "identifier",
                  "description": "(Required) Dataset identifier (API key associated with the target dataset)."
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entity\": \"<string>\",\n  \"data\": [\n    \"<object>\",\n    \"<object>\"\n  ],\n  \"override\": {\n    \"replaceAll\": \"<boolean>\",\n    \"replaceValuesForKey\": [\n      \"<string>\",\n      \"<string>\"\n    ]\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
