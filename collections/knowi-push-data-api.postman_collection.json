  "info": {
    "_postman_id": "b82e0dd0-36fa-46ac-966b-8d7109bc9e43",
    "name": "Knowi Push Data API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Knowi Push Data API enables real-time data ingestion to and retrieval from Knowi datasets. Send data via HTTP POST to create or update datasets on the fly, and pull data with SQL-like filters for export. API key authentication is used for all requests.\n\nContact Support:\n Name: Knowi Support\n Email: support@knowi.com",
      "type": "text/plain"
    }
  }
